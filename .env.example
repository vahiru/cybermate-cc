# 运行后端：codex | antigravity。antigravity 使用运行 CLI 的系统用户已登录的账号额度
# CGM_BACKEND=codex
# CGM_ANTIGRAVITY_BIN=agy
# Codex 模型端点（OpenAI Responses 兼容，Floway）和它的 key
# Antigravity 推理不需要此 key；保留 key 可继续使用现有的生图 API
LLM_API_KEY=
# CGM_LLM_BASE_URL=https://api.example.com/v1

# 用 bot 还是真人账号：bot | user
CGM_TRANSPORT=bot
# bot：BotFather 给的 token
TELEGRAM_BOT_TOKEN=
# user：sessions/live.enc 的口令。TG_API_ID/HASH 只在 login 时用（my.telegram.org 自己申请）
CGM_PASSPHRASE=
# TG_API_ID=
# TG_API_HASH=

# 你自己的 Telegram user id。管理命令只认它，提醒也私聊发给它
# （bot 模式要先私聊 bot 一次 /start；user 模式要先私聊那个账号一次）
CGM_OWNER_ID=
# 只在这些群里干活，逗号分隔。不知道 id 的话先留空，在群里发条消息，日志里会打印；
# user 模式也可以 docker compose run --rm cgm chats 列出来
CGM_CHATS=
# 谁能私聊它：members = 你 + 在上面这些群里说过话的人；all = 任何人；off = 不接私聊
CGM_DM=members
# 消息里出现这些词也算叫到它（@ 和回复本来就算）
CGM_NAMES=yuki,mochi,麻薯

# 以下都有默认值
# CGM_MODEL=claude-haiku-5-5
# antigravity 不设 CGM_MODEL 时沿用 CLI 的默认模型；用 agy models 查看可用 ID
# 不用生图 API 时可显式关闭：CGM_IMAGE_MODEL=
# 估算花费用的单价（美元/百万 token：输入,输出,缓存读,缓存写）。Floway 自己的计费以它为准
# CGM_PRICE=1,5,0.1,1.25
# antigravity 默认 0,0,0,0（账号额度，不折算 API 费用）；可自行设定估算单价
# 不许它点的表情，逗号或空格分隔。不设就用 cgm/config.py 里的默认名单（嘲讽、敷衍、冒犯类）
# CGM_REACTION_BLACKLIST=
# CGM_RUN_TIMEOUT=300
# CGM_HISTORY=50
# 没叫它的消息攒多少秒再一起跑；0 = 每条都立刻跑
# CGM_BATCH_SECONDS=45
# CGM_MAX_SENDS=5
# 发言前检测 GPT 式防御性结尾；0 = 关闭，默认开启（每轮最多要求改写一次）
# CGM_NOT_DONGPO=1
# CGM_COST_ALERT_USD=2
# CGM_KEEP_RUNS_HOURS=24
